{
  "extends": [
    "stylelint-config-standard"
  ],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "variants",
          "responsive",
          "screen",
          "theme",
          "layer",
          "container",
          "utility",
          "custom-variant",
          "reference",
          "plugin",
          "source"
        ]
      }
    ]
  }
}